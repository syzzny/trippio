# Open Exchange Rates App ID (https://openexchangerates.org/signup/free)
# 이 파일을 복사해 .env.local 로 만들고 값을 채워주세요. .env.local 은 git에 올라가지 않아요.
OPENEXCHANGERATES_APP_ID=

# Foursquare Places API — Service API Key (https://foursquare.com/developers)
FOURSQUARE_API_KEY=

# Groq API Key — 장소 이름 한국어화·현지 맛집 선별에 써요 (https://console.groq.com/keys)
GROQ_API_KEY=
# 선택: 모델을 직접 지정할 때만 (비워 두면 쓸 수 있는 모델을 자동으로 골라요)
GROQ_MODEL=
